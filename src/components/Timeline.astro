---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { chipsFor, groupChips } from '../lib/filter';
import { layoutTimeline } from '../lib/timeline';
import { formatRange, formatMonth } from '../lib/format';
import { techName } from '../data/tech';

const roleEntries = await getCollection('experience');
const projectEntries = await getCollection('projects');

// One shared set of grid rows for both columns. This is what makes "that
// project happened inside that job" true geometrically. See lib/timeline.ts.
const layout = layoutTimeline(
  roleEntries.map((r) => ({ id: r.id, start: r.data.start, end: r.data.end })),
  projectEntries.map((p) => ({ id: p.id, start: p.data.start })),
);

const rowOfProject = new Map(layout.projects.map((p) => [p.id, p.row]));
const spanOfRole = new Map(layout.roles.map((r) => [r.id, r]));

const chips = chipsFor(projectEntries.map((p) => ({ id: p.id, tech: p.data.tech })));
const chipGroups = groupChips(chips);
// Collapsed, the groups dissolve into one row; this rank keeps that row in
// overall usage order rather than category order (see .chip-item in global.css).
const rankOf = new Map(chips.map((chip, i) => [chip.slug, i]));
const projectCount = projectEntries.length;
const chipCount = chipGroups.reduce((n, group) => n + group.chips.length, 0);

const CONTEXT_LABEL = {
  work: 'Work',
  personal: 'Personal',
  research: 'Research',
  academic: 'University',
} as const;

const roles = await Promise.all(
  roleEntries.map(async (entry) => ({
    kind: 'role' as const,
    entry,
    span: spanOfRole.get(entry.id)!,
    Content: (await render(entry)).Content,
  })),
);

const projects = await Promise.all(
  projectEntries.map(async (entry) => ({
    kind: 'project' as const,
    entry,
    row: rowOfProject.get(entry.id)!,
    Content: (await render(entry)).Content,
  })),
);

/**
 * DOM order drives the single-column mobile layout, where the CSS grid placement
 * is switched off. Sorting by row (roles first at a tie) makes a phone read as
 * "here is the job, and here is what I built during it", which is the same story
 * the two columns tell on a wide screen.
 */
const items = [
  ...roles.map((role) => ({ ...role, row: role.span.rowStart })),
  ...projects,
].sort((a, b) => {
  const priority = { role: 0, project: 1 } as const;
  return a.row - b.row || priority[a.kind] - priority[b.kind];
});

// The topmost project's thumbnails sit above the fold on a desktop screen, so
// they load eagerly; every other image stays lazy.
const eagerImagesId = items.find((item) => item.kind === 'project' && item.entry.data.images?.length)?.entry.id;
---

<section id="timeline" class="mx-auto max-w-6xl px-6 pt-6 pb-14" aria-labelledby="timeline-heading">
  <h2
    id="timeline-heading"
    class="font-mono text-sm font-semibold tracking-[0.18em] text-(--color-ink) uppercase"
  >
    Projects &amp; roles
  </h2>
  {/* Phones only: from md up the sticky column headers say it instead. The
      caption has to be true in every state, and once a phone is filtered there
      are no roles on screen, hence tl-hint. */}
  <p class="tl-hint mt-2 max-w-2xl text-sm text-(--color-ink-faint) md:hidden">
    Each role, followed by what I built during it.
  </p>

  <!-- Real checkboxes in a real fieldset: keyboard and screen-reader support
       without ARIA gymnastics. Ships hidden, because with no JS it would do
       nothing; the script reveals it. -->
  <form id="tech-filter" class="no-print mt-8 hidden" data-filter-form data-expanded="false">
    <fieldset>
      <legend class="text-sm text-(--color-ink-soft) max-md:sr-only">
        Filter by technology <span class="text-(--color-ink-faint)"
          >(projects using any of them)</span
        >
      </legend>

      {/* Below md the chips fold away behind this button, so the filter is one
          line until asked for; from md up there is room and it is always open. */}
      <button
        type="button"
        class="filter-open flex w-full items-center justify-between rounded-md border border-(--color-rule) px-3 py-2 text-sm text-(--color-ink-soft) md:hidden"
        aria-controls="tech-filter-body"
        aria-expanded="false"
        data-filter-open
      >
        <span>Filter by technology <span class="text-(--color-accent)" data-filter-open-count></span></span>
        <svg class="filter-open-chevron size-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 6l4 4 4-4" />
        </svg>
      </button>

      <!-- Collapsed, the groups dissolve into one flat row of the technologies used
           more than once (see .chip-groups in global.css); expanded, each category
           gets its own row. On a phone a category label sits on its own line above
           its chips; side by side from md up. -->
      <div id="tech-filter-body" class="filter-body">
      <div id="tech-chips" class="chip-groups mt-4 space-y-2.5">
        {
          chipGroups.map((group) => (
            <div class="chip-group md:flex md:items-baseline md:gap-x-2">
              <p class="chip-group-label font-mono text-[0.6875rem] tracking-wide text-(--color-ink-faint) md:w-24 md:shrink-0">
                {group.label}
              </p>
              <div class="chip-row mt-1.5 flex flex-wrap gap-1.5 md:mt-0">
              {group.chips.map((chip) => (
                <div
                  class="chip-item"
                  data-minor={chip.count < 2 ? '' : undefined}
                  style={`--rank: ${rankOf.get(chip.slug)}`}
                >
                  <input
                    type="checkbox"
                    id={`tech-${chip.slug}`}
                    name="tech"
                    value={chip.slug}
                    data-name={chip.name}
                    class="chip-input sr-only"
                  />
                  <label
                    for={`tech-${chip.slug}`}
                    class="chip block cursor-pointer rounded-full border border-(--color-rule) bg-(--color-paper) px-3 py-1 text-[0.875rem] select-none hover:border-(--color-ink-faint) md:px-2.5 md:py-0.5 md:text-[0.8125rem]"
                  >
                    {chip.name}
                    {/* Decorative: without aria-hidden the accessible name
                        becomes "React3", read aloud as "React three". */}
                    <span
                      class="ml-1 font-mono text-[0.6875rem] opacity-55"
                      aria-hidden="true"
                    >
                      {chip.count}
                    </span>
                  </label>
                </div>
              ))}
              </div>
            </div>
          ))
        }
      </div>

      <button
        type="button"
        class="mt-3 text-sm text-(--color-accent) underline decoration-(--color-rule) decoration-2 underline-offset-4 hover:decoration-(--color-accent)"
        aria-controls="tech-chips"
        aria-expanded="false"
        data-filter-toggle
        data-label-more={`Show all ${chipCount} technologies`}
        data-label-less="Show fewer">Show all {chipCount} technologies</button
      >
      </div>
    </fieldset>
  </form>

  <!-- The answer to "what did that click do?". Visually hidden while idle; while
       a filter is on it sits under the chips and sticks to the top of the screen,
       so the result count and the way back out stay in view however far the
       reader scrolls. -->
  <div
    class="filter-bar no-print hidden mt-4 -mx-6 px-6 py-2.5 md:-mx-3 md:px-3"
    data-filter-bar
    data-active="false"
  >
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
      <p aria-live="polite" class="text-(--color-ink-soft)" data-filter-count></p>
      <ul class="flex flex-wrap gap-1.5" aria-label="Selected technologies" data-filter-pills></ul>
      <button
        type="reset"
        form="tech-filter"
        class="ml-auto hidden text-(--color-accent) underline decoration-(--color-rule) decoration-2 underline-offset-4 hover:decoration-(--color-accent)"
        data-filter-reset>Clear filter</button
      >
    </div>
  </div>

  <!-- Column headers, on the same grid as the timeline below. They stick while
       the timeline scrolls, so the reader never loses which side is which. -->
  <div
    class="tl-heads font-mono text-xs font-semibold tracking-[0.18em] text-(--color-ink-soft) uppercase"
  >
    <p>Projects</p>
    <p>Roles</p>
  </div>

  <div class="tl mt-6 md:mt-0 md:pt-2.5" data-timeline data-filtering="false">
    {
      items.map((item) => {
        if (item.kind === 'role') {
          const { entry, span, Content } = item;
          return (
            <div
              class="tl-role"
              style={`--row-start: ${span.rowStart}; --row-end: ${span.rowEnd}`}
              data-kind={entry.data.kind}
            >
              {/* The rail is the whole point of the layout: its length is the
                  job's real duration, so every project beside it visibly
                  happened during that job. */}
              <span class="tl-rail" aria-hidden="true"></span>
              <div
                class:list={[
                  'tl-role-card rounded-md border px-4 py-3',
                  entry.data.kind === 'education'
                    ? 'border-(--color-rule-soft) bg-transparent'
                    : 'border-(--color-rule) bg-(--color-paper-sunk)',
                ]}
              >
                <h3
                  class:list={[
                    'leading-snug',
                    entry.data.kind === 'education' ? 'font-normal' : 'font-semibold',
                  ]}
                >
                  {entry.data.role}
                </h3>
                <p class="text-sm text-(--color-ink-soft)">{entry.data.org}</p>
                <p class="mt-0.5 font-mono text-[0.6875rem] text-(--color-ink-faint)">
                  {formatRange(entry.data.start, entry.data.end)}
                  <span class="mx-1 opacity-50">·</span>
                  {entry.data.location}
                </p>

                <div class="prose-tight mt-2.5 text-[0.875rem] leading-relaxed text-(--color-ink-soft)">
                  <Content />
                </div>

                <ul class="mt-2.5 flex flex-wrap gap-x-2 gap-y-1" aria-label="Technologies">
                  {entry.data.tech.map((slug, i) => (
                    <li class="font-mono text-[0.6875rem] tracking-wide text-(--color-ink-faint)">
                      {i > 0 && (
                        <span class="mr-2 text-(--color-rule)" aria-hidden="true">
                          ·
                        </span>
                      )}
                      {techName(slug)}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          );
        }

        const { entry, row, Content } = item;
        return (
          <div
            class="tl-project"
            style={`--row: ${row}`}
            data-entry
            data-match="true"
            data-tech={entry.data.tech.join(' ')}
          >
            {/* Thumbnails sit beside the title where there is room, and drop below
                it on a phone; beside it they would squeeze the title to a sliver. */}
            <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:gap-3">
              <div class="min-w-0 flex-1 sm:max-w-[60%] sm:flex-none">
                <h3 class="entry-title leading-snug font-semibold">
                  {entry.data.repo ? (
                    <a
                      href={entry.data.repo}
                      class="underline decoration-(--color-rule) decoration-2 underline-offset-4 transition-colors hover:decoration-(--color-accent)"
                      rel="noopener"
                    >
                      {entry.data.title}
                    </a>
                  ) : (
                    entry.data.title
                  )}
                </h3>

                <p class="mt-0.5 font-mono text-[0.6875rem] tracking-wide text-(--color-ink-faint)">
                  {entry.data.end
                    ? formatRange(entry.data.start, entry.data.end)
                    : formatMonth(entry.data.start)}
                  <span class="mx-1.5 opacity-50">·</span>
                  {CONTEXT_LABEL[entry.data.context]}
                  {/* Only the employer or university the project was done for. Which
                      job a personal project ran alongside is already plain from
                      the roles column. */}
                  {entry.data.org && (
                    <>
                      <span class="mx-1.5 opacity-50">·</span>
                      {entry.data.org}
                    </>
                  )}
                </p>
              </div>

              {/* Beside the title the strip fills whatever room the title leaves, so it
                  never crowds it; any images past that scroll, and the arrows
                  (shown by the script below) say there is more. */}
              {entry.data.images && entry.data.images.length > 0 && (
                <div class="thumb-strip relative -mr-6 flex min-w-0 sm:mr-0 sm:flex-1 sm:justify-end" data-thumb-strip>
                <div
                  class="thumb-scroller flex min-w-0 flex-row gap-1.5 overflow-x-auto pr-6 sm:pr-0"
                  data-thumb-scroller
                  data-lightbox-group={entry.id}
                >
                  {entry.data.images.map((img) => (
                    <a
                      href={img.src.src}
                      target="_blank"
                      rel="noopener"
                      class="block"
                      aria-label={`Open full-size image: ${img.alt}`}
                      data-lightbox-trigger
                      data-lightbox-alt={img.alt}
                      data-lightbox-portrait={img.src.height > img.src.width ? '' : undefined}
                      data-lightbox-no-caption={entry.data.imageCaptions ? undefined : ''}
                    >
                      <Image
                        src={img.src}
                        alt={img.alt}
                        width={160}
                        height={112}
                        loading={entry.id === eagerImagesId ? 'eager' : 'lazy'}
                        class="h-14 w-20 max-w-none rounded border border-(--color-rule) bg-(--color-paper-sunk) object-cover"
                      />
                    </a>
                  ))}
                </div>
                {/* Mouse-only shortcuts: keyboard users tab through the thumbnails,
                    which scroll themselves into view. */}
                <button
                  type="button"
                  class="thumb-arrow thumb-arrow-start"
                  tabindex="-1"
                  aria-hidden="true"
                  data-thumb-arrow="-1"
                >
                  <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 4l-4 4 4 4" />
                  </svg>
                </button>
                <button
                  type="button"
                  class="thumb-arrow thumb-arrow-end"
                  tabindex="-1"
                  aria-hidden="true"
                  data-thumb-arrow="1"
                >
                  <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 4l4 4-4 4" />
                  </svg>
                </button>
                </div>
              )}
            </div>

            <div class="entry-body mt-2">
              <p class="text-[0.9375rem] leading-relaxed text-(--color-ink-soft) text-pretty">
                {entry.data.summary}
              </p>

              <div class="prose-tight mt-2 space-y-2 text-[0.875rem] leading-relaxed text-(--color-ink-faint) text-pretty">
                <Content />
              </div>

              <ul class="mt-2.5 flex flex-wrap gap-1" aria-label="Technologies used">
                {entry.data.tech.map((slug) => (
                  <li
                    class="tech-tag rounded border border-(--color-rule-soft) bg-(--color-paper-sunk) px-1.5 py-0.5 font-mono text-[0.6875rem] text-(--color-ink-faint)"
                    data-tech-tag={slug}
                  >
                    {techName(slug)}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        );
      })
    }
  </div>

  <p class="tl-hint mt-4 text-xs text-(--color-ink-faint)">
    {projectCount} projects · roles shown as bars spanning their dates
  </p>
</section>

<script>
  // Each thumbnail strip shows an arrow on whichever side has images scrolled
  // out of view; clicking it pages the strip that way.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const strip of document.querySelectorAll<HTMLElement>('[data-thumb-strip]')) {
    const scroller = strip.querySelector<HTMLElement>('[data-thumb-scroller]');
    if (!scroller) continue;

    const update = () => {
      const max = scroller.scrollWidth - scroller.clientWidth;
      // A pixel of slack: zoomed pages leave fractional scroll offsets.
      strip.dataset.moreStart = String(scroller.scrollLeft > 1);
      strip.dataset.moreEnd = String(scroller.scrollLeft < max - 1);
    };

    for (const arrow of strip.querySelectorAll<HTMLButtonElement>('[data-thumb-arrow]')) {
      arrow.addEventListener('click', () => {
        scroller.scrollBy({
          left: Number(arrow.dataset.thumbArrow) * scroller.clientWidth * 0.8,
          behavior: reduceMotion.matches ? 'auto' : 'smooth',
        });
      });
    }

    scroller.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(scroller);
    update();
  }
</script>
