---
import { site } from '../data/site';

const link =
  'underline decoration-(--color-rule) decoration-2 underline-offset-4 transition-colors hover:decoration-(--color-accent)';
---

<footer id="contact" class="mx-auto max-w-6xl px-6 pt-6 pb-20">
  <div
    class="flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-(--color-rule) pt-7 text-sm text-(--color-ink-faint)"
  >
    <span class="text-(--color-ink-soft)">
      Contact me on <a
        href={site.links.linkedin}
        class={`font-medium text-(--color-accent) ${link}`}
        rel="me noopener">LinkedIn</a
      >
    </span>
    <span class="sm:ml-auto">
      Built with <a href="https://astro.build" class={link} rel="noopener">Astro</a>{' · '}<a
        href={site.links.source}
        class={link}
        rel="noopener">source</a
      >
    </span>
  </div>
</footer>
