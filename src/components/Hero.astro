---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="relative mx-auto max-w-6xl px-6 pt-12 pb-6 sm:pt-10">
  {/* The sliding header has its own; this one serves the top of the page,
      where that header is hidden. */}
  <ThemeToggle class="no-print absolute top-3 right-4.5 sm:top-4" />

  <h1
    class="font-serif text-5xl leading-[1.05] font-medium tracking-tight text-balance sm:text-6xl"
  >
    {site.name}
  </h1>

  <p class="mt-5 max-w-2xl text-xl leading-snug text-(--color-ink-soft) text-pretty">
    {site.tagline}
  </p>

  <p class="mt-6 max-w-2xl leading-relaxed text-(--color-ink-soft) text-pretty">
    {site.intro}
  </p>

  <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm">
    <a
      href={site.links.linkedin}
      class="font-medium text-(--color-accent) underline decoration-(--color-rule) decoration-2 underline-offset-4 transition-colors hover:decoration-(--color-accent)"
      rel="me noopener"
    >
      LinkedIn
    </a>
    <a
      href={site.links.github}
      class="font-medium text-(--color-accent) underline decoration-(--color-rule) decoration-2 underline-offset-4 transition-colors hover:decoration-(--color-accent)"
      rel="me noopener"
    >
      GitHub
    </a>
  </div>

  <p class="mt-4 text-sm text-(--color-ink-soft)">
    {
      site.languages.map((lang, i) => (
        <>
          {i > 0 && <span class="text-(--color-rule)"> / </span>}
          <span>
            {lang.name} <span class="font-mono text-xs">{lang.level}</span>
          </span>
        </>
      ))
    }
  </p>
</header>
