---
/**
 * The filter's only client-side code.
 *
 * It reads checkbox state, delegates the decision to the pure functions in
 * lib/filter.ts, and writes two attributes: `data-filtering` on the root and
 * `data-match` on each entry. All dimming and collapsing is CSS. That is why
 * there is no framework here: the DOM work is genuinely this small.
 *
 * The one piece of extra feedback is the results bar: a click on a chip changes
 * a timeline that may be off-screen, so the bar says in words what happened
 * ("4 of 17 projects use React") and offers a way back out.
 */
---

<script>
  import { describeMatch, matches, parseTechParam, serializeTechParam } from '../lib/filter';

  const form = document.querySelector<HTMLFormElement>('[data-filter-form]');
  const timeline = document.querySelector<HTMLElement>('[data-timeline]');
  const bar = document.querySelector<HTMLElement>('[data-filter-bar]');
  const countEl = document.querySelector<HTMLElement>('[data-filter-count]');
  const pillsEl = document.querySelector<HTMLElement>('[data-filter-pills]');
  const resetEl = document.querySelector<HTMLElement>('[data-filter-reset]');
  const toggleEl = document.querySelector<HTMLButtonElement>('[data-filter-toggle]');

  if (form && timeline) {
    const boxes = [...form.querySelectorAll<HTMLInputElement>('input[name="tech"]')];
    const entries = [...timeline.querySelectorAll<HTMLElement>('[data-entry]')].map((el) => ({
      el,
      id: el.dataset.tech ?? '',
      tech: (el.dataset.tech ?? '').split(' ').filter(Boolean),
    }));
    const nameOf = new Map(boxes.map((b) => [b.value, b.dataset.name ?? b.value]));

    // The filter does nothing without JS, so it ships hidden and is revealed here.
    form.classList.remove('hidden');
    bar?.classList.remove('hidden');

    // Every tech pill on every card, so a selected technology can be picked out
    // within the cards that survived the filter.
    const tags = [...timeline.querySelectorAll<HTMLElement>('[data-tech-tag]')];

    const renderPills = (selected: Set<string>) => {
      if (!pillsEl) return;
      pillsEl.replaceChildren(
        ...[...selected].map((slug) => {
          const li = document.createElement('li');
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'filter-pill';
          button.dataset.removeTech = slug;
          button.setAttribute('aria-label', `Remove ${nameOf.get(slug)} from filter`);
          button.textContent = nameOf.get(slug) ?? slug;
          const x = document.createElement('span');
          x.setAttribute('aria-hidden', 'true');
          x.textContent = '×';
          button.append(x);
          li.append(button);
          return li;
        }),
      );
    };

    const apply = (selected: Set<string>, pushUrl: boolean) => {
      const active = selected.size > 0;
      timeline.dataset.filtering = String(active);
      if (bar) bar.dataset.active = String(active);

      let matched = 0;
      for (const entry of entries) {
        const isMatch = matches(entry, selected);
        entry.el.dataset.match = String(isMatch);
        if (isMatch) matched += 1;
      }

      // Show which tag earned the match. One generic loop; the accent itself is
      // defined once in CSS, shared with the chip that selected it.
      for (const tag of tags) {
        tag.dataset.selected = String(selected.has(tag.dataset.techTag ?? ''));
      }

      if (countEl) {
        countEl.textContent = describeMatch(
          matched,
          entries.length,
          [...selected].map((slug) => nameOf.get(slug) ?? slug),
        );
      }
      renderPills(selected);
      resetEl?.classList.toggle('hidden', !active);

      if (pushUrl) {
        const param = serializeTechParam(selected);
        const url = new URL(window.location.href);
        if (param) url.searchParams.set('tech', param);
        else url.searchParams.delete('tech');
        // Commas are legal in a query string, and URLSearchParams escapes them to
        // %2C regardless. Put them back: this link gets pasted into messages, so
        // `?tech=csharp,react` beats `?tech=csharp%2Creact`.
        url.search = url.searchParams.toString().replace(/%2C/g, ',');
        // replaceState, not pushState: filtering should not fill the back button.
        window.history.replaceState({}, '', url);
      }
    };

    const readSelection = () =>
      new Set(boxes.filter((b) => b.checked).map((b) => b.value));

    form.addEventListener('change', () => apply(readSelection(), true));

    form.addEventListener('reset', () => {
      // The reset event fires before the inputs clear, so defer a frame.
      requestAnimationFrame(() => apply(readSelection(), true));
    });

    // A pill in the bar unticks its chip, wherever the chips have scrolled to.
    pillsEl?.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLElement>('[data-remove-tech]');
      const box = boxes.find((b) => b.value === button?.dataset.removeTech);
      if (!box) return;
      box.checked = false;
      apply(readSelection(), true);
    });

    toggleEl?.addEventListener('click', () => {
      const expanded = form.dataset.expanded !== 'true';
      form.dataset.expanded = String(expanded);
      toggleEl.setAttribute('aria-expanded', String(expanded));
      toggleEl.textContent =
        (expanded ? toggleEl.dataset.labelLess : toggleEl.dataset.labelMore) ?? '';
    });

    // Restore a shared link's filter state: ?tech=react,python
    const fromUrl = parseTechParam(new URLSearchParams(window.location.search).get('tech'));
    for (const box of boxes) box.checked = fromUrl.has(box.value);
    apply(fromUrl, false);
  }
</script>
